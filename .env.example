DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-a-random-string-of-at-least-32-characters"

# Facturation Pennylane (optionnel — laissez vide si non utilisé)
# Clé API : générée dans Pennylane > Paramètres > API (jeton "Company API token")
PENNYLANE_API_KEY=""
# Identifiant numérique du client Pennylane à facturer (OPCO, CFA...) — visible dans son URL Pennylane
PENNYLANE_CUSTOMER_ID=""
# Prix unique appliqué par repas/présence facturée (obligatoire, aucune valeur par défaut dans le code)
PENNYLANE_PRIX_REPAS="3.00"
# Taux de TVA Pennylane à appliquer (ex: "exempt", "FR_055", "FR_200") — à valider avec votre comptable
PENNYLANE_VAT_RATE="exempt"
